+        continue
+      }
+      if (top > 0) break
+    }
+    if (top < 0) return false
+    if (top - pos.y > 1.6) return false
+    return doesNotCollide(world, new Vec3(pos.x + dx * 0.6, top, pos.z + dz * 0.6))
+  }
