diff --git a/test/water-climb.test.js b/test/water-climb.test.js
new file mode 100644
index 0000000..e08920a
--- /dev/null
+++ b/test/water-climb.test.js
@@ -0,0 +1,117 @@
+/* eslint-env mocha */
+
+// v10.5.1 Segs regression test — swimming climb-out onto a 1-high
+// shore. Before the fix the out-of-liquid impulse only fired on ticks
+// when horizontal velocity happened to be ~0 (the old gate tested
+// whether the full 1.8-high box fit 0.6 above the feet, which can
+// never pass against a 1-high shore), and it stopped entirely once
+// the feet rose above ~70.6 because isInWater flips false there —
+// so the player bobbed to ~71.6 and fell back forever (run-106 pond).
+// The fix tests the landing (top of the blocking block + headroom)
+// and keeps the impulse for 10 ticks after the feet leave the water.
+const { Physics, PlayerState } = require('prismarine-physics')
+const { Vec3 } = require('vec3')
+const expect = require('expect')
+
+const mcData = require('minecraft-data')('26.3')
+const Block = require('prismarine-block')('26.3')
+
+const STONE = mcData.blocksByName.stone.id
+const WATER = mcData.blocksByName.water.id
+const AIR = mcData.blocksByName.air.id
+
+// Pond matching run 106: floor stone y69, water y70 (x -95..-85),
+// shore stone y71 (top 72) west of x=-95, air above.
+function pondWorld (shoreHeight) {
+  return {
+    getBlock: (pos) => {
+      let type = AIR
+      if (pos.y === 69) type = STONE
+      if (pos.y === 70 && pos.x >= -95 && pos.x <= -85 && pos.z >= 155 && pos.z <= 165) type = WATER
+      if (pos.x < -95 && pos.y >= 71 && pos.y < 71 + shoreHeight && pos.z >= 150 && pos.z <= 170) type = STONE
+      const b = new Block(type, 0, 0)
+      b.position = pos
+      return b
+    }
+  }
+}
+
+function fakePlayer (pos) {
+  return {
+    entity: {
+      position: pos,
+      velocity: new Vec3(0, 0, 0),
+      onGround: false,
+      isInWater: false,
+      isInLava: false,
+      isInWeb: false,
+      isCollidedHorizontally: false,
+      isCollidedVertically: false,
+      elytraFlying: false,
+      yaw: Math.PI / 2, // forward = west, into the shore
+      pitch: 0,
+      effects: {}
+    },
+    jumpTicks: 0,
+    jumpQueued: false,
+    fireworkRocketDuration: 0,
+    version: '26.3',
+    inventory: { slots: [] }
+  }
+}
+
+function swimAtShore (world, ticks) {
+  const physics = Physics(mcData, world)
+  const controls = { forward: true, back: false, left: false, right: false, jump: true, sprint: true, sneak: false }
+  const player = fakePlayer(new Vec3(-90, 70, 160.5))
+  const state = new PlayerState(player, controls)
+  let maxFeet = -Infinity
+  for (let i = 0; i < ticks; i++) {
+    physics.simulatePlayer(state, world).apply(player)
+    maxFeet = Math.max(maxFeet, player.entity.position.y)
+    if (player.entity.position.y >= 72 && player.entity.position.x < -95) return { player, maxFeet, outAt: i }
+  }
+  return { player, maxFeet, outAt: -1 }
+}
+
+function swimAtShoreFromFloat (world, ticks) {
+  // Live case (run 117): Segs arrives at the wall already floating at
+  // the surface (feet 70.61), where the fork's contracted-BB isInWater
+  // check already reads false — the boost must still arm (body contact
+  // with water) and climb Segs out.
+  const physics = Physics(mcData, world)
+  const controls = { forward: true, back: false, left: false, right: false, jump: true, sprint: true, sneak: false }
+  const player = fakePlayer(new Vec3(-94.7, 70.61, 160.5))
+  const state = new PlayerState(player, controls)
+  let maxFeet = -Infinity
+  for (let i = 0; i < ticks; i++) {
+    physics.simulatePlayer(state, world).apply(player)
+    maxFeet = Math.max(maxFeet, player.entity.position.y)
+    if (player.entity.position.y >= 72 && player.entity.position.x < -95) return { player, maxFeet, outAt: i }
+  }
+  return { player, maxFeet, outAt: -1 }
+}
+
+describe('Water climb-out (v10.5.1 Segs)', () => {
+  it('climbs a 1-high shore out of 1-deep water', () => {
+    const { player, maxFeet, outAt } = swimAtShore(pondWorld(1), 400)
+    expect(outAt).toBeGreaterThanOrEqual(0)
+    expect(player.entity.position.y).toBeGreaterThanOrEqual(72)
+    expect(player.entity.position.x).toBeLessThan(-95)
+    expect(maxFeet).toBeGreaterThanOrEqual(72)
+  })
+
+  it('does not climb a 2-high wall out of the water', () => {
+    const { player, maxFeet } = swimAtShore(pondWorld(2), 400)
+    expect(player.entity.position.y).toBeLessThan(73)
+    expect(maxFeet).toBeLessThan(73)
+  })
+
+  it('climbs a 1-high shore when starting at the surface float (feet 70.61)', () => {
+    const { player, maxFeet, outAt } = swimAtShoreFromFloat(pondWorld(1), 400)
+    expect(outAt).toBeGreaterThanOrEqual(0)
+    expect(player.entity.position.y).toBeGreaterThanOrEqual(72)
+    expect(player.entity.position.x).toBeLessThan(-95)
+    expect(maxFeet).toBeGreaterThanOrEqual(72)
+  })
+})
