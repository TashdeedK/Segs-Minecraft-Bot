+    // ~2.4 — and have a full 1.8 of headroom above it (the box shifted
+    // toward the wall, as it will be once Segs moves forward).
+    const bx = Math.floor(pos.x + dx * 0.6)
+    const bz = Math.floor(pos.z + dz * 0.6)
